// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  role      String     @default("user")
  avatar    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  teams     Team[]
  activities Activity[]

  @@index([email])
}

model Team {
  id          String     @id @default(cuid())
  name        String
  description String?
  members     User[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  projects    Project[]

  @@index([createdAt])
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String?
  teamId      String
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([teamId])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  resource  String
  userId    String
  changes   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([resource])
}
